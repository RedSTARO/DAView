<?xml version="1.0" encoding="utf-8"?>
<!-- The same decision for Android 11 and earlier, which read this file instead
     of data_extraction_rules. There is no way here to say "only if encrypted",
     so config.json, with the WebDAV password and the scraper keys in plain
     text, stays on the device: after a restore the credentials are typed in
     again, and the library and the watch history are already there. -->
<full-backup-content>
    <exclude domain="file" path="daview/config.json" />
    <exclude domain="file" path="daview/offline/" />
    <exclude domain="file" path="daview/cache/" />
    <exclude domain="file" path="daview/updates/" />
    <exclude domain="external" path="." />
</full-backup-content>
