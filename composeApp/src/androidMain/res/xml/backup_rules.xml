<?xml version="1.0" encoding="utf-8"?>
<!-- The same decision for Android 11 and earlier, which read this file instead
     of data_extraction_rules. There is no way here to say "only if encrypted",
     so config.json, with the WebDAV password and the scraper keys in plain
     text, stays on the device: after a restore the credentials are typed in
     again, and the library and the watch history are already there.
     Include only the catalogue and UI preferences: excluding config.json by
     name still backed up config.json.tmp and config.json.unreadable-* copies. -->
<full-backup-content>
    <include domain="file" path="daview/daview.db" />
    <include domain="file" path="daview/daview.db-wal" />
    <include domain="file" path="daview/daview.db-shm" />
    <include domain="sharedpref" path="daview.xml" />
</full-backup-content>
